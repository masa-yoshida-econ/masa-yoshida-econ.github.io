@unpublished{yoshida_qiu_laborshare,
  theme      = {climate},
  section    = {pub},
  title      = {Climate Change and the Decline of Labor Share},
  author     = {Qiu, Xincheng and Yoshida, Masahiro},
  author_url = {Xincheng Qiu: https://www.xinchengqiu.com/},
  year       = {2026},
  month      = {5},
  status     = {Accepted},
  journal    = {American Economic Journal: Macroeconomics},
  url_pdf    = {papers/Yoshida_Qiu_LaborShare.pdf},
  url_iza    = {https://docs.iza.org/dp17485.pdf},
  talks      = {Talks 2024: Waseda (macro); 2025: Econometric Society World Congress; 2026: JEA (Fall)},
  abstract   = {We study the impact of climate change on the labor share. Combining newly constructed US county-industry-level labor shares with climate variables, we find that extreme temperatures reduce the labor share, with stronger effects in industries with higher climate exposure and automation potential. Extreme temperatures also accelerate robot adoption. A back-of-the-envelope calculation suggests that the within-county-industry response to climate change accounts for 15\% of the decline in labor share since 2000. Over the 20th century, however, the opposing effects of decreased cold days and increased hot days offset each other, consistent with the historical stability of labor share.}
}

@unpublished{yoshida_toohot,
  theme      = {climate},
  section       = {wp},
  title         = {Too Hot to Work? The Erosion of Male Comparative Advantage in Outdoor Jobs},
  author        = {Yoshida, Masahiro},
  year          = {2026},
  status        = {Major Revision Requested},
  journal       = {Journal of Labor Economics},
  note          = {Job Market Paper},
  url_pdf       = {papers/Yoshida_TooHotToWork.pdf},
  url_slides    = {papers/Yoshida_TooHotToWork_slides.pdf},
  url_ssrn      = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5250267},
  url_media     = {https://www.openaccessgovernment.org/article/climate-change-and-the-rise-of-adult-male-dropouts/193257/},
  url_media_pdf = {papers/Yoshida_TooHotToWork_summary.pdf},
  talks         = {Talks 2023: Waseda, Hitotsubashi (urban/trade), Kyoto (urban), GRIPS; 2024: Keio, Tokyo Labor Workshop, Trans-Pacific Labor Seminars, JEA (Fall), Econometric Society Australasian Meeting; 2025: Kansai Labor Workshop},
  abstract      = {Prime-age male labor force participation has trended downward since the 1970s. I develop and test a task-based model in which rising temperatures shrink the outdoor-job premium, by shifting firm labor demand and raising the value of time at home, thereby lowering participation. Measuring daily work-hour temperature across US commuting zones using weather-station data spanning five decades, I find that sustained exposure to extreme heat and cold reduces prime-age men's participation, especially among non-college workers in nonmetropolitan areas, with little effect for women. The decline is stronger where outdoor jobs and housing amenities (e.g., air conditioning) are more prevalent. Climate change deepens regional and educational divides in men's labor market attachment.},
  month = {10}
}

